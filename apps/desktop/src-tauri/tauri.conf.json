{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossWarp",
  "version": "0.1.0",
  "identifier": "com.crosswarp.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrossWarp",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
